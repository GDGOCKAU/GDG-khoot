# Leave these unset: the app calls the address it was opened from (LAN IP, localhost or a
# tunnel URL) and Vite forwards /api, /socket.io and /uploads to the backend.
# KAUHOOT_API (read by vite.config.js) points Vite at the backend; default http://127.0.0.1:3000.
# Set VITE_API_URL / VITE_SOCKET_URL only if the API must be called on a different origin.
# VITE_API_URL=http://localhost:3000
# VITE_SOCKET_URL=http://localhost:3000
