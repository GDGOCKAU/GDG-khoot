# Leave these unset on the LAN: the app then calls the API on the same host it
# was opened from, port 3000 (e.g. http://192.168.100.120:3000), so phones work.
# Set them only when the API lives on a different host or port.
# VITE_API_URL=http://localhost:3000
# VITE_SOCKET_URL=http://localhost:3000
