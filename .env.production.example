# Copy to .env in the deploy folder on the server (next to docker-compose.yml). Never commit the real file.
# Make random values with:  openssl rand -hex 32
# Use letters and digits only for POSTGRES_PASSWORD (it goes inside the database URL).
POSTGRES_PASSWORD=change-me-long-random
JWT_SECRET=change-me-at-least-16-characters-random
ADMIN_PASSWORD=change-me-8-plus-chars
# ADMIN_EMAIL=admin@gdg-kauhoot.local
# Host port for the site (e.g. 8080 if another web server already uses port 80)
WEB_PORT=80
