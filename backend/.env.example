DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kahoot?schema=public"
JWT_SECRET="replace-this-in-development"
PORT=3000
HOST="0.0.0.0"
UPLOAD_DIR="uploads"
# Admin sign-in. Required: the server will not start without it (at least 8 characters).
# On every start the server makes the stored password match this value, so to change the
# admin password: edit it here, then restart the server. Never commit the real value.
ADMIN_EMAIL="admin@gdg-kauhoot.local"
ADMIN_PASSWORD="example-only-change-me"
